{
  "name": "smart-perpustakaan-rfid",
  "productName": "PustakaSmart RFID",
  "version": "1.0.0",
  "author": "PustakaSmart Developer",
  "description": "Sistem Perpustakaan Sekolah Digital RFID & E-Book PDF",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:exe": "vite build && npx electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.pustakasmart.rfid",
    "productName": "PustakaSmart RFID",
    "directories": {
      "output": "dist_exe"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "server.cjs",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^33.4.11",
    "oxlint": "^1.79.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  }
}
